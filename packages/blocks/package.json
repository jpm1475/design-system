{
  "name": "@jpm1475/ds-blocks",
  "version": "0.1.0",
  "description": "Full-width page sections composed from @jpm1475/ds-components.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@jpm1475/ds-components": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpm1475/design-system.git",
    "directory": "packages/blocks"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "rollup-preserve-directives": "^1.1.3",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest-axe": "^0.1.0"
  }
}
